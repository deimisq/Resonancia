[Unit]
Description=Resonancia (voz IA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=resonancia
WorkingDirectory=/opt/resonancia
EnvironmentFile=/etc/resonancia.env
ExecStart=/opt/resonancia/node_modules/.bin/tsx server.ts
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

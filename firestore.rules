rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidVoice(v) {
      return v is string && (
        v in ['Kore', 'Zephyr', 'Puck', 'Charon', 'Fenrir', 'custom'] ||
        (v.size() >= 6 && v.size() <= 160 && v.matches('^voice_[a-zA-Z0-9_\\-]+$'))
      );
    }

    function isValidIntensity(i) {
      return i is string && i in ['subtle', 'balanced', 'intense'];
    }

    function isValidPace(p) {
      return p is string && p in ['slow', 'natural', 'dynamic'];
    }

    function isValidEngine(e) {
      return e is string && e in [
        'gemini-3.8-flash-tts',
        'gemini-3.8-flash-lite-tts',
        'opensource-hf',
        'opensource-endpoint'
      ];
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid', 'displayName', 'preferredVoice', 'preferredEmotionId',
        'preferredStyle', 'preferredIntensity', 'preferredPace',
        'preferredEngine', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'displayName', 'photoURL', 'preferredVoice', 'preferredCustomVoiceId',
        'preferredEmotionId', 'preferredStyle', 'preferredIntensity', 'preferredPace',
        'preferredEngine', 'createdAt', 'updatedAt'
      ]) &&
      data.uid is string && data.uid == userId && data.uid == request.auth.uid && isValidId(data.uid) &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
      (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
      (!('preferredCustomVoiceId' in data) || (data.preferredCustomVoiceId is string && data.preferredCustomVoiceId.size() <= 128 && data.preferredCustomVoiceId.matches('^[a-zA-Z0-9_\\-]*$'))) &&
      isValidVoice(data.preferredVoice) &&
      data.preferredEmotionId is string && data.preferredEmotionId.size() >= 1 && data.preferredEmotionId.size() <= 60 &&
      data.preferredStyle is string && data.preferredStyle.size() <= 1200 &&
      isValidIntensity(data.preferredIntensity) &&
      isValidPace(data.preferredPace) &&
      isValidEngine(data.preferredEngine) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'hasConfiguredApiKey', 'updatedAt']) &&
      data.keys().hasOnly(['uid', 'email', 'hasConfiguredApiKey', 'updatedAt']) &&
      data.uid is string && data.uid == userId && data.uid == request.auth.uid && isValidId(data.uid) &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
      data.hasConfiguredApiKey is bool &&
      data.updatedAt is timestamp;
    }

    function isValidTake(data, userId) {
      return data.keys().hasAll([
        'ownerId', 'title', 'mode', 'voiceSummary', 'emotionLabel',
        'styleUsed', 'scriptText', 'durationSeconds', 'modelUsed',
        'favorite', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId', 'title', 'mode', 'voiceSummary', 'emotionLabel',
        'styleUsed', 'scriptText', 'durationSeconds', 'modelUsed',
        'favorite', 'createdAt', 'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid && isValidId(data.ownerId) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
      data.mode is string && data.mode in ['single', 'dialogue'] &&
      data.voiceSummary is string && data.voiceSummary.size() >= 1 && data.voiceSummary.size() <= 120 &&
      data.emotionLabel is string && data.emotionLabel.size() >= 1 && data.emotionLabel.size() <= 120 &&
      data.styleUsed is string && data.styleUsed.size() <= 1200 &&
      data.scriptText is string && data.scriptText.size() >= 1 && data.scriptText.size() <= 15000 &&
      data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 86400 &&
      data.modelUsed is string && data.modelUsed.size() >= 1 && data.modelUsed.size() <= 80 &&
      data.favorite is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId) &&
        isVerifiedOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(userId) &&
        isVerifiedOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'preferredVoice', 'preferredCustomVoiceId',
            'preferredEmotionId', 'preferredStyle', 'preferredIntensity',
            'preferredPace', 'preferredEngine', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'preferredVoice', 'preferredCustomVoiceId', 'preferredEmotionId',
            'preferredStyle', 'preferredIntensity', 'preferredPace',
            'preferredEngine', 'updatedAt'
          ])
        );

      allow delete: if false;

      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'info' && isVerifiedOwner(userId);
        allow list: if false;

        allow create: if isValidId(userId) &&
          docId == 'info' &&
          isVerifiedOwner(userId) &&
          isValidPrivateInfo(incoming(), userId) &&
          incoming().updatedAt == request.time;

        allow update: if isValidId(userId) &&
          docId == 'info' &&
          isVerifiedOwner(userId) &&
          isValidPrivateInfo(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'email', 'hasConfiguredApiKey', 'updatedAt'
          ]);

        allow delete: if false;
      }

      match /takes/{takeId} {
        allow get: if isValidId(userId) && isValidId(takeId) && isVerifiedOwner(userId);
        allow list: if isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId) &&
          isValidId(takeId) &&
          isVerifiedOwner(userId) &&
          isValidTake(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;

        allow update: if isValidId(userId) &&
          isValidId(takeId) &&
          isVerifiedOwner(userId) &&
          isValidTake(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['favorite', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt'])
          );

        allow delete: if isValidId(userId) && isValidId(takeId) && isVerifiedOwner(userId);
      }
    }
  }
}

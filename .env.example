# ==============================================================================
# Resonancia — Variables de entorno
# Copia este archivo como `.env` para desarrollo local (nunca subas `.env` a Git)
# ==============================================================================

# Puerto del servidor Express + Vite (por defecto 3000)
PORT=3000

# --- Modo BYOK (Bring Your Own Key) ---
# En despliegues públicos, mantén ALLOW_SERVER_FALLBACK_KEY=false para que
# cada usuario autenticado utilice obligatoriamente su propia clave de Gemini.
ALLOW_SERVER_FALLBACK_KEY=false

# Opcional: solo se usa si ALLOW_SERVER_FALLBACK_KEY=true en entornos privados
GEMINI_API_KEY=

# --- Firebase Authentication & Firestore ---
# ID del proyecto Firebase usado por firebase-admin en el backend para verificar ID tokens.
# Si no se define, server.ts lee `projectId` desde `firebase-applet-config.json`.
FIREBASE_PROJECT_ID=

# Opcional: sobrescribe la configuración web de Firebase para forks en GitHub
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
